@page "/login"
@inject AuthenticationStateProvider AuthStateProvider
@inject DemoAccountStore AccountStore
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<PageTitle>Sign In | ShopEase</PageTitle>

<AuthorizeView Context="authState">
    <Authorized>
        <section class="auth-page" aria-label="Account">
            <h1>You're Signed In</h1>
            <p>Signed in as <strong>@authState.User.Identity?.Name</strong>. This is a simulated
                session held in memory only — it will not survive a page refresh.</p>
            <button type="button" class="btn btn-primary" @onclick="HandleSignOut">Sign Out</button>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="auth-page" aria-label="Sign in">
            <h1>Sign In</h1>
            <p class="auth-page__intro">
                Sign in to add products to your cart and check out. This is a simulated login for a
                teaching project, not a real account system — see the demo accounts below.
            </p>

            <EditForm EditContext="_editContext" OnValidSubmit="HandleSignIn" class="auth-form">
                <DataAnnotationsValidator />

                <div class="auth-form__field">
                    <label for="login-username">Username</label>
                    <InputText id="login-username" class="auth-form__input" autocomplete="username"
                               @bind-Value="_model.Username" />
                    <ValidationMessage For="@(() => _model.Username)" class="auth-form__error" aria-live="polite" />
                </div>

                <div class="auth-form__field">
                    <label for="login-password">Password</label>
                    <InputText id="login-password" type="password" class="auth-form__input"
                               autocomplete="current-password" @bind-Value="_model.Password" />
                    <ValidationMessage For="@(() => _model.Password)" class="auth-form__error" aria-live="polite" />
                </div>

                @if (!string.IsNullOrEmpty(_signInError))
                {
                    <p class="auth-form__error" role="alert" aria-live="polite">@_signInError</p>
                }

                <button type="submit" class="btn btn-primary">Sign In</button>
            </EditForm>

            <div class="auth-demo-accounts" aria-label="Demo accounts">
                <h2>Demo Accounts</h2>
                <p>
                    These are openly published, fake demo credentials for this teaching project — not
                    real accounts, and nothing to keep secret. Sign in with either:
                </p>
                <ul>
                    @foreach (var account in AccountStore.DemoAccounts)
                    {
                        <li><code>@account.Username</code> / <code>@account.Password</code></li>
                    }
                </ul>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Presence and shape only -- SafeText/allow-list validation is appropriate for a
    // username, but never for a password, which must compare byte-exact against the
    // store and must never be silently rewritten. See InputValidationService's remarks.
    private class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(30, MinimumLength = 3, ErrorMessage = "Username must be 3-30 characters.")]
        [SafeText]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;
    }

    private readonly LoginModel _model = new();
    private EditContext _editContext = default!;
    private string? _signInError;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private void HandleSignIn()
    {
        var username = InputValidationService.Sanitize(_model.Username);
        if (AccountStore.Validate(username, _model.Password))
        {
            _signInError = null;
            ((DemoAuthenticationStateProvider)AuthStateProvider).MarkUserAsAuthenticated(username);
            Navigation.NavigateTo("products");
        }
        else
        {
            _signInError = "Invalid username or password.";
        }
    }

    private void HandleSignOut()
    {
        ((DemoAuthenticationStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
    }
}

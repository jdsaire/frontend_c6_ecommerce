@page "/products"
@inject Cart Cart
@using System.ComponentModel.DataAnnotations

<PageTitle>Shop | ShopEase</PageTitle>

<section class="storefront">
    <div class="storefront-toolbar" aria-label="Product filters">
        <label class="storefront-filter">
            <svg class="storefront-filter__icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M1 2h14l-5 6v5l-4 2v-7z" fill="currentColor" />
            </svg>
            <span class="visually-hidden">Filter by category</span>
            <select @bind="_selectedCategory" @bind:after="ApplyFilters">
                <option value="All">All Categories</option>
                @foreach (var category in _categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>

        <label class="storefront-filter">
            <svg class="storefront-filter__icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 2v10M4 12l-2.5-2.5M4 12l2.5-2.5M12 14V4M12 4l-2.5 2.5M12 4l2.5 2.5"
                      stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="visually-hidden">Sort by price</span>
            <select @bind="_sortOrder" @bind:after="ApplyFilters">
                <option value="none">Sort: Featured</option>
                <option value="price-asc">Price: Low to High ↑</option>
                <option value="price-desc">Price: High to Low ↓</option>
            </select>
        </label>

        @* A plain <input> rather than <InputText> deliberately: this is an ARIA
           combobox, which needs per-keystroke value control plus its own keydown
           handling, and <InputText> cannot combine @bind-Value:event="oninput"
           with @bind-Value:after. Validation is unchanged — the same SearchModel,
           EditContext, DataAnnotationsValidator, and ValidationMessage still drive
           it, via the explicit _searchEditContext.Validate() call in ApplyFilters. *@
        <EditForm EditContext="_searchEditContext" class="storefront-filter storefront-search">
            <DataAnnotationsValidator />
            <svg class="storefront-filter__icon" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
            <label for="storefront-search-input" class="visually-hidden">Search products</label>

            <div class="storefront-search__control">
                <input id="storefront-search-input"
                       @ref="_searchInput"
                       class="storefront-search__input"
                       type="text"
                       placeholder="Search products…"
                       maxlength="60"
                       autocomplete="off"
                       role="combobox"
                       aria-expanded="@(_suggestionsOpen ? "true" : "false")"
                       aria-controls="storefront-search-suggestions"
                       aria-autocomplete="list"
                       aria-activedescendant="@ActiveSuggestionId"
                       value="@_searchModel.Term"
                       @oninput="HandleSearchInput"
                       @onkeydown="HandleSearchKeyDown"
                       @onblur="CloseSuggestions" />

                @if (!string.IsNullOrEmpty(_searchModel.Term))
                {
                    <button type="button" class="storefront-search__clear"
                            aria-label="Clear search" title="Clear search"
                            @onclick="ClearSearch">
                        &times;
                    </button>
                }

                @* Always rendered so aria-controls always points at a real element,
                   hidden via the attribute rather than a CSS :empty rule, which
                   stray whitespace text nodes would defeat. *@
                <ul id="storefront-search-suggestions" class="storefront-search__suggestions"
                    role="listbox" aria-label="Product suggestions" hidden="@(!_suggestionsOpen)">
                    @if (_suggestionsOpen)
                    {
                        @for (var i = 0; i < _suggestions.Count; i++)
                        {
                            var index = i;
                            var suggestion = _suggestions[index];
                            <li id="@SuggestionId(index)"
                                class="storefront-search__suggestion@(index == _activeSuggestionIndex ? " storefront-search__suggestion--active" : "")"
                                role="option"
                                aria-selected="@(index == _activeSuggestionIndex ? "true" : "false")"
                                @onmousedown:preventDefault="true"
                                @onclick="@(() => SelectSuggestion(suggestion))">
                                @suggestion
                            </li>
                        }
                    }
                </ul>
            </div>

            <ValidationMessage For="@(() => _searchModel.Term)" class="storefront-search__error" aria-live="polite" />
        </EditForm>
    </div>

    <div class="storefront-grid">
        @foreach (var product in _displayedProducts.Take(_visibleCount))
        {
            <AuthorizeView Context="cartAuthState">
                <Authorized>
                    <ProductCard Product="product"
                                 Quantity="Cart.GetQuantity(product.ProductID)"
                                 CanModifyCart="true"
                                 OnAddToCart="HandleAddToCart"
                                 OnIncrement="HandleIncrement"
                                 OnDecrement="HandleDecrement"
                                 OnRemove="HandleRemove" />
                </Authorized>
                <NotAuthorized>
                    <ProductCard Product="product"
                                 Quantity="Cart.GetQuantity(product.ProductID)"
                                 CanModifyCart="false"
                                 OnAddToCart="HandleAddToCart"
                                 OnIncrement="HandleIncrement"
                                 OnDecrement="HandleDecrement"
                                 OnRemove="HandleRemove" />
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>

    <div class="storefront-show-more">
        <p class="storefront-show-more__count" aria-live="polite">
            Showing @Math.Min(_visibleCount, _displayedProducts.Count) of @_displayedProducts.Count products
            @if (!string.IsNullOrWhiteSpace(_searchModel.Term))
            {
                <text> matching "@_searchModel.Term"</text>
            }
        </p>
        @if (_visibleCount < _displayedProducts.Count)
        {
            <button type="button" class="btn btn-primary storefront-show-more__button" @onclick="ShowMore">
                Show more
            </button>
        }
    </div>

    <section class="storefront-cart-summary" aria-label="Cart summary">
        <h2>Cart Summary</h2>
        @if (!Cart.Items.Any())
        {
            <p><em>Cart is empty.</em></p>
            <p><strong>Total: $@Cart.CalculateTotal().ToString("F2")</strong></p>
        }
        else
        {
            <ul>
                @foreach (var line in Cart.GetGroupedItems())
                {
                    <li>@line.Product.Name &times; @line.Quantity — $@line.LineTotal.ToString("F2")</li>
                }
            </ul>
            <p><strong>Total: $@Cart.CalculateTotal().ToString("F2")</strong></p>
            <AuthorizeView Context="checkoutAuthState">
                <Authorized>
                    <a class="btn btn-primary storefront-cart-summary__checkout" href="checkout">
                        Proceed to Checkout
                    </a>
                </Authorized>
                <NotAuthorized>
                    <p class="storefront-cart-summary__signin-note">
                        <a href="login">Sign in</a> to proceed to checkout.
                    </p>
                </NotAuthorized>
            </AuthorizeView>
        }
    </section>
</section>

@code {
    private const int PageSize = 6;

    // Deliberately minimal: DataAnnotations needs a bindable model even for a single
    // field, and this is what the search box's EditForm binds and validates against.
    private class SearchModel
    {
        [SafeText]
        [StringLength(60, ErrorMessage = "Search text can be at most 60 characters.")]
        public string Term { get; set; } = string.Empty;
    }

    private List<Product> _products = new();
    private List<Product> _displayedProducts = new();
    private List<string> _categories = new();
    private string _selectedCategory = "All";
    private string _sortOrder = "none";
    private int _visibleCount = PageSize;

    private readonly SearchModel _searchModel = new();
    private EditContext _searchEditContext = default!;
    private bool _searchIsValid = true;

    // Autocomplete state. Suggestions are drawn from the catalog itself, so a
    // selected suggestion is always a real product keyword -- but it still goes
    // through the same validation path as anything typed by hand.
    private const int MinSuggestionLength = 2;
    private const int MaxSuggestions = 6;
    private static readonly char[] KeywordSeparators = { ' ', '-', '/' };

    private ElementReference _searchInput;
    private List<string> _catalogKeywords = new();
    private List<string> _suggestions = new();
    private int _activeSuggestionIndex = -1;
    private bool _suggestionsOpen;

    private string? ActiveSuggestionId =>
        _suggestionsOpen && _activeSuggestionIndex >= 0 ? SuggestionId(_activeSuggestionIndex) : null;

    private static string SuggestionId(int index) => $"storefront-search-suggestion-{index}";

    protected override void OnInitialized()
    {
        _products = MockProductData.GetSeedProducts();
        _categories = _products.Select(p => p.Category).Distinct().OrderBy(c => c).ToList();
        _catalogKeywords = BuildCatalogKeywords(_products);
        _searchEditContext = new EditContext(_searchModel);
        ApplyFilters();
    }

    // One distinct, title-cased keyword per meaningful word in the catalog's product
    // names, so typing "la" can offer both "Lamp" (from "Desk Lamp") and "Laptop"
    // rather than only matching names that start with the typed text. Fragments with
    // no letters ("27") or shorter than three characters are dropped as noise.
    private static List<string> BuildCatalogKeywords(IEnumerable<Product> products)
    {
        return products
            .SelectMany(p => p.Name.Split(KeywordSeparators, StringSplitOptions.RemoveEmptyEntries))
            .Select(word => word.Trim())
            .Where(word => word.Length >= 3 && word.Any(char.IsLetter))
            .Select(word => char.ToUpperInvariant(word[0]) + word[1..])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(word => word, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ApplyFilters()
    {
        // Validate on every keystroke so the inline message tracks live typing
        // instead of waiting for a submit this form never has.
        _searchIsValid = _searchEditContext.Validate();
        var searchTerm = _searchIsValid ? InputValidationService.Sanitize(_searchModel.Term) : string.Empty;

        IEnumerable<Product> filtered = _selectedCategory == "All"
            ? _products
            : _products.Where(p => p.Category == _selectedCategory);

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filtered = filtered.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        _displayedProducts = _sortOrder switch
        {
            "price-asc" => filtered.OrderBy(p => p.Price).ToList(),
            "price-desc" => filtered.OrderByDescending(p => p.Price).ToList(),
            _ => filtered.ToList(),
        };

        _visibleCount = PageSize;
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchModel.Term = e.Value?.ToString() ?? string.Empty;
        _activeSuggestionIndex = -1;
        ApplyFilters();
        UpdateSuggestions();
    }

    private void UpdateSuggestions()
    {
        var term = _searchModel.Term.Trim();

        if (term.Length < MinSuggestionLength || !_searchIsValid)
        {
            _suggestions = new List<string>();
            _suggestionsOpen = false;
            return;
        }

        _suggestions = _catalogKeywords
            .Where(keyword => keyword.StartsWith(term, StringComparison.OrdinalIgnoreCase)
                              && !keyword.Equals(term, StringComparison.OrdinalIgnoreCase))
            .Take(MaxSuggestions)
            .ToList();

        _suggestionsOpen = _suggestions.Count > 0;
    }

    private void SelectSuggestion(string suggestion)
    {
        _searchModel.Term = suggestion;
        CloseSuggestions();
        ApplyFilters();
    }

    private void CloseSuggestions()
    {
        _suggestionsOpen = false;
        _activeSuggestionIndex = -1;
    }

    private async Task ClearSearch()
    {
        _searchModel.Term = string.Empty;
        _suggestions = new List<string>();
        CloseSuggestions();
        ApplyFilters();

        // Return focus to the field rather than stranding it on a button that is
        // about to disappear, so a keyboard user can keep typing immediately.
        await _searchInput.FocusAsync();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (!_suggestionsOpen)
                {
                    UpdateSuggestions();
                }

                if (_suggestions.Count > 0)
                {
                    _activeSuggestionIndex = (_activeSuggestionIndex + 1) % _suggestions.Count;
                }

                break;

            case "ArrowUp":
                if (_suggestions.Count > 0)
                {
                    _activeSuggestionIndex = _activeSuggestionIndex <= 0
                        ? _suggestions.Count - 1
                        : _activeSuggestionIndex - 1;
                }

                break;

            case "Enter":
                if (_suggestionsOpen && _activeSuggestionIndex >= 0)
                {
                    SelectSuggestion(_suggestions[_activeSuggestionIndex]);
                }

                break;

            case "Escape":
                // Standard combobox behavior: the first Escape dismisses the list,
                // a second one clears the field.
                if (_suggestionsOpen)
                {
                    CloseSuggestions();
                }
                else if (_searchModel.Term.Length > 0)
                {
                    _searchModel.Term = string.Empty;
                    ApplyFilters();
                }

                break;
        }
    }

    private void ShowMore()
    {
        _visibleCount = Math.Min(_visibleCount + PageSize, _displayedProducts.Count);
    }

    private void HandleAddToCart(Product product)
    {
        Cart.AddProduct(product);
        Cart.NotifyChange();
    }

    private void HandleIncrement(Product product)
    {
        Cart.IncrementQuantity(product.ProductID);
    }

    private void HandleDecrement(Product product)
    {
        Cart.DecrementQuantity(product.ProductID);
    }

    private void HandleRemove(Product product)
    {
        Cart.RemoveProduct(product.ProductID);
        Cart.NotifyChange();
    }
}

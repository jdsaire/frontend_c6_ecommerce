@* Lives in Pages/ rather than a components folder because the capstone brief
   names this exact location — see Pages/README.md for why this is kept as-is. *@

<div class="product-card">
    <p>@Product.GetDetails()</p>
    <button class="btn btn-primary" @onclick="HandleAddToCartClick">Add to Cart</button>
</div>

@code {
    [Parameter]
    public Product Product { get; set; } = default!;

    // Raised when the button above is clicked; the parent page supplies the
    // handler, so ProductCard itself never touches Cart directly.
    [Parameter]
    public EventCallback<Product> OnAddToCart { get; set; }

    private async Task HandleAddToCartClick()
    {
        await OnAddToCart.InvokeAsync(Product);
    }
}

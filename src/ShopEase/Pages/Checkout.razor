@page "/checkout"
@using System.ComponentModel.DataAnnotations

<PageTitle>Checkout | ShopEase</PageTitle>

<section class="checkout-page" aria-label="Checkout">
    <h1>Checkout</h1>
    <p class="checkout-page__intro">
        This is a demo submission for a teaching project — no payment is collected or
        processed, and nothing you enter here is stored anywhere beyond this page.
    </p>

    <EditForm Model="_model" class="checkout-form">
        <DataAnnotationsValidator />

        <div class="checkout-form__field">
            <label for="checkout-name">Full Name</label>
            <InputText id="checkout-name" class="checkout-form__input" autocomplete="name"
                       @bind-Value="_model.FullName" />
            <ValidationMessage For="@(() => _model.FullName)" class="checkout-form__error" />
        </div>

        <div class="checkout-form__field">
            <label for="checkout-address">Shipping Address</label>
            <InputText id="checkout-address" class="checkout-form__input" autocomplete="street-address"
                       @bind-Value="_model.Address" />
            <ValidationMessage For="@(() => _model.Address)" class="checkout-form__error" />
        </div>

        <div class="checkout-form__field">
            <label for="checkout-city">City</label>
            <InputText id="checkout-city" class="checkout-form__input" autocomplete="address-level2"
                       @bind-Value="_model.City" />
            <ValidationMessage For="@(() => _model.City)" class="checkout-form__error" />
        </div>

        <div class="checkout-form__field">
            <label for="checkout-postal">Postal / ZIP Code</label>
            <InputText id="checkout-postal" class="checkout-form__input" autocomplete="postal-code"
                       @bind-Value="_model.PostalCode" />
            <ValidationMessage For="@(() => _model.PostalCode)" class="checkout-form__error" />
        </div>

        <div class="checkout-form__field">
            <label for="checkout-email">Email</label>
            <InputText id="checkout-email" type="email" class="checkout-form__input" autocomplete="email"
                       @bind-Value="_model.Email" />
            <ValidationMessage For="@(() => _model.Email)" class="checkout-form__error" />
        </div>

        <button type="submit" class="btn btn-primary">Place Order</button>
    </EditForm>
</section>

@code {
    // Deliberately minimal and deliberately non-financial: no card number, no CVV, no
    // expiry, no separate billing address. See docs/security-decisions.md for why.
    private class CheckoutModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        [StringLength(80, MinimumLength = 2, ErrorMessage = "Full name must be 2-80 characters.")]
        [SafeText]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Shipping address is required.")]
        [StringLength(120, MinimumLength = 5, ErrorMessage = "Address must be 5-120 characters.")]
        [SafeText]
        public string Address { get; set; } = string.Empty;

        [Required(ErrorMessage = "City is required.")]
        [StringLength(60, MinimumLength = 2, ErrorMessage = "City must be 2-60 characters.")]
        [SafeText]
        public string City { get; set; } = string.Empty;

        [Required(ErrorMessage = "Postal/ZIP code is required.")]
        [StringLength(12, MinimumLength = 3, ErrorMessage = "Postal/ZIP code must be 3-12 characters.")]
        [SafeText]
        public string PostalCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(254, ErrorMessage = "Email is too long.")]
        public string Email { get; set; } = string.Empty;
    }

    private readonly CheckoutModel _model = new();
}
